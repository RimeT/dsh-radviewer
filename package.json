{
  "name": "dsh-radviewer",
  "version": "0.1.0-alpha.1",
  "license": "MIT",
  "private": false,
  "description": "Interactive 3D medical image viewer for the DSH sidebar.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RimeT/dsh-radviewer.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "keywords": ["dsh", "deepseek-harness", "dicom", "nifti", "nrrd", "radiology"],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "medview-path.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "scripts": {
    "build:worker": "node scripts/build-worker.mjs",
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build",
    "check": "node scripts/selfcheck.mjs",
    "dev": "node scripts/build-worker.mjs && vite"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
